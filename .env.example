# Copy to .env.local and fill in. Nothing here is required to browse the site; the contact form
# reports "not configured" honestly until the email variables below are set.

# Public site URL (used for canonical URLs, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Contact form email delivery (Resend: https://resend.com) ---
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend
CONTACT_FROM_EMAIL=
# Where project enquiries are delivered
CONTACT_TO_EMAIL=

# --- Booking (optional): your Calendly (or similar) scheduling link ---
NEXT_PUBLIC_BOOKING_URL=

# --- Analytics (optional): loads only after a visitor accepts analytics cookies ---
NEXT_PUBLIC_GA4_ID=

# --- Trust details (all optional; each is shown only when set, so nothing is invented) ---
NEXT_PUBLIC_AGENCY_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
# Registered business identity for the footer
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_REGISTRATION=
NEXT_PUBLIC_LOCATION=
# Your working time zone (IANA name) and hours; enables the "we overlap now" hint on the clocks
NEXT_PUBLIC_AGENCY_TZ=
NEXT_PUBLIC_WORKING_HOURS=09:00-18:00
# Only set what you will really do, e.g. "within one business day"
NEXT_PUBLIC_RESPONSE_TIME=
# Independent review profiles (shown in the footer and a "Check us out" section)
NEXT_PUBLIC_GOOGLE_PROFILE_URL=
NEXT_PUBLIC_CLUTCH_URL=
NEXT_PUBLIC_TRUSTPILOT_URL=

# --- AI features (website audit summary, roadmap, content planner, headline lab, site assistant, brief helper) ---
# Server-side only: never prefix with NEXT_PUBLIC_. Leave GEMINI_API_KEY empty to switch AI off (the audit still runs its 30 measured checks).
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: switch provider to Anthropic (Claude)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Optional: comma-separated model fallback chains (model names change over time)
# AI_MODEL_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# AI_MODEL_STRONG=gemini-3.5-flash,gemini-3.5-flash-lite
# Global ceiling on AI calls per UTC day, to cap cost and abuse
AI_DAILY_LIMIT=300
# Opt in to an internal AI triage note (summary, priority, draft reply) in the enquiry email. Sends enquiry text to the AI provider.
AI_LEAD_SUMMARY=0
# Optional: Google PageSpeed endpoint override for the audit's speed test
# PSI_BASE_URL=
# TEST ONLY. Never set these in production:
# AUDIT_ALLOW_PRIVATE=1   (lets the audit fetch private/localhost addresses)
# AI_RATE_SCALE=100       (multiplies per-visitor AI rate limits)
# AI_BASE_URL=            (points AI calls at a mock server)
# FORM_RATE_SCALE=100     (multiplies the contact form rate limit)
